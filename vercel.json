{
  "version": 2,
  "cleanUrls": true,
  "outputDirectory": ".",
  "buildCommand": null,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "scenarios/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/dashboard/(.*)", "destination": "/dashboard/$1" },
    { "source": "/styles/(.*)", "destination": "/dashboard/styles/$1" },
    { "source": "/src/(.*)", "destination": "/dashboard/src/$1" },
    { "source": "/components/(.*)", "destination": "/dashboard/components/$1" },
    { "source": "/vendor/(.*)", "destination": "/dashboard/vendor/$1" },
    { "source": "/scenarios/(.*)", "destination": "/scenarios/$1" },
    { "source": "/simulation/(.*)", "destination": "/simulation/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/dashboard/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/scenarios/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/api/trace/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(index.html)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/dashboard/(index.html)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(src|components|styles)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/dashboard/(src|components|styles)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
